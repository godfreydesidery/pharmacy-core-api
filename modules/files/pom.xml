<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tz.co.pharmacy</groupId>
        <artifactId>pharmacy-core-api</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>pharmacy-files</artifactId>
    <name>pharmacy-files</name>
    <description>The files module: stored files and attachments (prescription images, logos) behind a storage port with local-disk and S3-compatible adapters. Depends on pharmacy-platform only.</description>

    <dependencies>
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-platform</artifactId>
        </dependency>
        <!-- The S3-compatible store (AWS S3, MinIO, Cloudflare R2). Version from the AWS SDK BOM in the
             root pom. Only the JDK's HttpURLConnection client: no Apache or Netty client in the jar. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache-client</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>
        <!-- FilesS3StorageTest also runs the store against S3Mock in a container when Docker is up. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The in-process S3 fake (FakeS3) is shared with pharmacy-core's end-to-end test. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

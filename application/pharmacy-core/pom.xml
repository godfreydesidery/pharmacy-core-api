<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>tz.co.pharmacy</groupId>
        <artifactId>pharmacy-core-api</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>pharmacy-core</artifactId>
    <name>pharmacy-core</name>
    <description>The single deployable: the application, platform/composition (the only place modules are bound together), configuration, the root administrator bootstrap and the development seed.</description>

    <properties>
        <spring-boot.run.skip>false</spring-boot.run.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-platform</artifactId>
        </dependency>
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-tenancy</artifactId>
        </dependency>
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-access</artifactId>
        </dependency>
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-catalogue</artifactId>
        </dependency>
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-partners</artifactId>
        </dependency>
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-inventory</artifactId>
        </dependency>
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-purchasing</artifactId>
        </dependency>
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-receivables</artifactId>
        </dependency>
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-insurance</artifactId>
        </dependency>
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-sales</artifactId>
        </dependency>
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-finance</artifactId>
        </dependency>
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-reporting</artifactId>
        </dependency>
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-integrations</artifactId>
        </dependency>
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-fx</artifactId>
        </dependency>
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-notifications</artifactId>
        </dependency>
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-files</artifactId>
        </dependency>
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-onboarding</artifactId>
        </dependency>
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-checkout</artifactId>
        </dependency>
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-receiving</artifactId>
        </dependency>
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-delivery</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Metrics at /actuator/prometheus, on the management port (PHARMACY_MANAGEMENT_PORT). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- The optional error tracker: does nothing unless SENTRY_DSN is set (PII off). -->
        <dependency>
            <groupId>io.sentry</groupId>
            <artifactId>sentry-spring-boot-4</artifactId>
            <version>${sentry.version}</version>
        </dependency>
        <dependency>
            <groupId>io.sentry</groupId>
            <artifactId>sentry-logback</artifactId>
            <version>${sentry.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-windows-amd64</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.zonky.test.postgres</groupId>
            <artifactId>embedded-postgres-binaries-linux-amd64</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- FakeS3, the in-process S3-compatible server, for FilesOnS3Test. -->
        <dependency>
            <groupId>tz.co.pharmacy</groupId>
            <artifactId>pharmacy-files</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- The runnable jar is pharmacy-core-*-exec.jar; the plain jar stays usable as a dependency. -->
                    <classifier>exec</classifier>
                </configuration>
                <executions>
                    <!-- META-INF/build-info.properties: the build's version and time in /actuator/info (STD-16). -->
                    <execution>
                        <id>build-info</id>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
